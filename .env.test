# Chargé par Vite avec `--mode test` (loadEnv). Commité : aucun secret ici.
#
# Active le registre `window.__services__` consommé par la couche L2
# (ADR-006). Volontairement ABSENT de `.env` : un build par défaut ne doit
# pas embarquer de surface de test.
#
# Corollaire assumé : la CI produit deux artefacts — celui qu'on teste
# (`build:test`) et celui qu'on livre (`build`).
VITE_TEST_HOOKS=true
